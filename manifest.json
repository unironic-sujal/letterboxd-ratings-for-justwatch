{
  "manifest_version": 3,
  "name": "Letterboxd Ratings for JustWatch",
  "version": "1.0.0",
  "description": "See Letterboxd ratings on every JustWatch movie tile. Instant badges, hover details, rating filter — no account needed.",
  "minimum_chrome_version": "88",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.justwatch.com/*"],
      "js":  ["content/content.js"],
      "css": ["ui/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.justwatch.com/*",
    "https://letterboxd.com/*",
    "https://api.themoviedb.org/*"
  ]
}
